# Frontend
VITE_API_BASE_URL=http://localhost:8787
VITE_API_TIMEOUT_MS=10000

# Backend
NODE_ENV=development
PORT=8787
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=rdmx
JWT_AUDIENCE=rdmx-api
JWT_EXPIRES_IN=2h
PUBLIC_BASE_URL=http://localhost:5173
OPENWEATHER_API_KEY=
STRIPE_SECRET_KEY=
REALITO_AI_URL=
REALITO_AI_API_KEY=

# Security
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
AI_REQUEST_TIMEOUT_MS=5000
AI_MAX_PROMPT_CHARS=800
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/rdmx
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/rdmx_shadow
